# Appended to hostapd 2.12's defconfig for the bench's access points: stock
# hostapd, its default capability, and the two options the tests need.

# 802.11v: bss_transition=1 and the BSS_TM_REQ control command (tests B5 to B7)
CONFIG_WNM=y

# Only for bss_load_test, a fixed BSS Load element in the beacons (test B8); no
# other testing option is used
CONFIG_TESTING_OPTIONS=y
