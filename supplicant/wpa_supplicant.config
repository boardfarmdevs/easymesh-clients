# Appended to wpa_supplicant 2.12's defconfig. The defconfig already has the
# simple background scan (which brings in WNM), SAE, FT, OWE, DPP and
# 802.11ac/ax/be; it does not have MBO.

# The patch series' background scan module: the load trigger and roam scans on
# beacon loss (patch 0002)
CONFIG_BGSCAN_MODEL=y

# A model's PHY ceiling (capabilities.phy_max): the network options disable_ht,
# disable_vht and disable_he exist only with these (disable_eht always does)
CONFIG_HT_OVERRIDES=y
CONFIG_VHT_OVERRIDES=y
CONFIG_HE_OVERRIDES=y
